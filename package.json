{
  "name": "charta-home",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "db:verify": "node scripts/verify-schema.mjs",
    "db:test": "node scripts/verify-rls.mjs",
    "db:seed:verify": "node scripts/verify-seed.mjs",
    "db:bundle": "node scripts/bundle-migrations.mjs",
    "db:bundle:verify": "node scripts/bundle-migrations.mjs && node scripts/verify-bundle.mjs",
    "auth:check": "node scripts/verify-auth-errors.mjs",
    "db:check": "npm run db:verify && npm run db:test && npm run db:seed:verify && npm run db:bundle:verify && npm run reminders:check && npm run receipt:check && npm run uploads:check && npm run email:check && npm run phone:check && npm run siteurl:check",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types typescript --local > lib/supabase/types.generated.ts",
    "reminders:check": "node scripts/verify-reminders.mjs",
    "receipt:check": "node scripts/verify-receipt-escaping.mjs",
    "siteurl:check": "node --experimental-strip-types --no-warnings scripts/verify-site-url.mjs",
    "phone:check": "node --experimental-strip-types --no-warnings scripts/verify-phone.mjs",
    "email:check": "node --experimental-strip-types --no-warnings scripts/verify-email.mjs",
    "reset:check": "node scripts/verify-reset-flow.mjs",
    "whatsapp:check": "node scripts/verify-whatsapp-flow.mjs",
    "email:config": "node --experimental-strip-types --no-warnings scripts/check-email-config.mjs",
    "uploads:check": "node scripts/verify-uploads.mjs",
    "switcher:check": "node scripts/verify-switcher.mjs",
    "activity:check": "node --experimental-strip-types --no-warnings scripts/verify-activity.mjs",
    "pricing:check": "node --experimental-strip-types --no-warnings scripts/verify-pricing.mjs",
    "admin:grant": "node --experimental-strip-types --no-warnings scripts/grant-admin.mjs",
    "payunit:check": "node --experimental-strip-types --no-warnings scripts/verify-payunit.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.3",
    "country-flag-icons": "^1.6.20",
    "next": "^15.4.5",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.5",
    "@tailwindcss/postcss": "^4.1.11",
    "@types/node": "^24.1.0",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "postcss": "^8.5.6",
    "supabase": "^2.114.0",
    "tailwindcss": "^4.1.11",
    "typescript": "^5.8.3"
  }
}
